<Window x:Class="Beacon.UI.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:ui="clr-namespace:Beacon.UI"
        Title="Beacon"
        Width="700"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Two looks share this one window: Classic (rounded, neutral) and HUD (futuristic,
         cyan, cut corners). Everything that differs is either a DynamicResource - swapped
         wholesale in SearchWindow.ApplyStyle - or a HUD-only layer toggled on and off.
         The values below are the Classic palette; ApplyStyle overwrites them. -->
    <Window.Resources>
        <SolidColorBrush x:Key="Surface"        Color="#F01C1C1F" />
        <SolidColorBrush x:Key="SurfaceBorder"  Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="Divider"        Color="#18FFFFFF" />
        <SolidColorBrush x:Key="TextPrimary"    Color="#F2FFFFFF" />
        <SolidColorBrush x:Key="TextSecondary"  Color="#8CFFFFFF" />
        <SolidColorBrush x:Key="TextTertiary"   Color="#59FFFFFF" />
        <SolidColorBrush x:Key="Accent"         Color="#FF5B8DEF" />
        <SolidColorBrush x:Key="GlyphTint"      Color="#59FFFFFF" />
        <SolidColorBrush x:Key="SelectionFill"  Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="SelectionBar"   Color="Transparent" />
        <SolidColorBrush x:Key="HoverFill"      Color="#10FFFFFF" />
        <SolidColorBrush x:Key="ChipFill"       Color="#265B8DEF" />
        <SolidColorBrush x:Key="ChipBorder"     Color="#665B8DEF" />
        <SolidColorBrush x:Key="ListenFill"     Color="#40FF5B5B" />
        <SolidColorBrush x:Key="ListenBack"     Color="#30FF5B5B" />
        <SolidColorBrush x:Key="ListenGlyph"    Color="#FFFF7A7A" />
        <SolidColorBrush x:Key="HudLine"        Color="#6635E6FF" />
        <SolidColorBrush x:Key="HudBright"      Color="#FF35E6FF" />
        <SolidColorBrush x:Key="HudDim"         Color="#8035E6FF" />
        <SolidColorBrush x:Key="DangerFill"     Color="#33FF6B5B" />
        <SolidColorBrush x:Key="Danger"         Color="#FFFF8A7A" />
        <SolidColorBrush x:Key="FrameBright"    Color="#FF35E6FF" />
        <SolidColorBrush x:Key="FrameInner"     Color="Transparent" />
        <SolidColorBrush x:Key="RowPlate"       Color="Transparent" />
        <SolidColorBrush x:Key="RowStripe"      Color="Transparent" />
        <SolidColorBrush x:Key="RowStripeActive" Color="Transparent" />
        <SolidColorBrush x:Key="RowHover"       Color="#10FFFFFF" />
        <!-- Tactical tiles: body, its raised lip, outline, and the floating panel fill.
             All transparent in the other looks, which draw one big frame instead. -->
        <SolidColorBrush x:Key="TileFill"       Color="Transparent" />
        <SolidColorBrush x:Key="TileFillActive" Color="Transparent" />
        <SolidColorBrush x:Key="TileHover"      Color="Transparent" />
        <SolidColorBrush x:Key="TileLip"        Color="Transparent" />
        <SolidColorBrush x:Key="TileLipActive"  Color="Transparent" />
        <SolidColorBrush x:Key="TileStroke"     Color="Transparent" />
        <SolidColorBrush x:Key="QueryFill"      Color="Transparent" />
        <SolidColorBrush x:Key="PanelFill"      Color="Transparent" />
        <CornerRadius x:Key="RowCorner">8</CornerRadius>
        <Thickness x:Key="RowMargin">6,1</Thickness>
        <Thickness x:Key="RowPadding">10,8</Thickness>
        <sys:Double x:Key="RowTitleSize">14</sys:Double>
        <sys:Double x:Key="RowSubSize">11.5</sys:Double>
        <sys:Double x:Key="QuerySize">21</sys:Double>
        <FontFamily x:Key="TitleFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="TagFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
        <FontFamily x:Key="GlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Rows are drawn by us; the default ListBoxItem chrome would fight the design. -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="{DynamicResource RowMargin}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <!-- Tactical tile: a lighter ledge under the body, so each result
                                 reads as a raised, angled key. It sits below the body rather
                                 than behind it - the body is translucent, and a slab behind
                                 it would show through as a washed-out band. -->
                            <ui:ChamferPlate x:Name="Lip"
                                             Height="4"
                                             Margin="40,0,0,0"
                                             VerticalAlignment="Bottom"
                                             Fill="{DynamicResource TileLip}"
                                             CutBottomLeft="4" />

                            <!-- Amber edge on the ledge, bottom right. -->
                            <Rectangle x:Name="Stripe"
                                       Height="4"
                                       Width="64"
                                       Margin="0,0,0,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Fill="{DynamicResource RowStripe}"
                                       IsHitTestVisible="False">
                                <Rectangle.RenderTransform>
                                    <SkewTransform AngleX="-45" />
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <ui:ChamferPlate x:Name="Body"
                                             Margin="0,0,0,4"
                                             Fill="{DynamicResource TileFill}"
                                             Stroke="{DynamicResource TileStroke}"
                                             CutTopLeft="6"
                                             CutTopRight="16" />

                            <Border x:Name="Root"
                                    Background="Transparent"
                                    CornerRadius="{DynamicResource RowCorner}"
                                    Padding="{DynamicResource RowPadding}">
                                <ContentPresenter />
                            </Border>

                            <!-- Selection marker on the left edge; transparent in Classic. -->
                            <Rectangle x:Name="SelBar"
                                       Width="3"
                                       Margin="0,7"
                                       HorizontalAlignment="Left"
                                       Fill="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SelectionFill}" />
                                <Setter TargetName="SelBar" Property="Fill" Value="{DynamicResource SelectionBar}" />
                                <Setter TargetName="Stripe" Property="Fill" Value="{DynamicResource RowStripeActive}" />
                                <Setter TargetName="Stripe" Property="Width" Value="150" />
                                <Setter TargetName="Body" Property="Fill" Value="{DynamicResource TileFillActive}" />
                                <Setter TargetName="Lip" Property="Fill" Value="{DynamicResource TileLipActive}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource RowHover}" />
                                <Setter TargetName="Body" Property="Fill" Value="{DynamicResource TileHover}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer margin gives the glow / drop shadow somewhere to render. -->
    <Grid x:Name="Chrome" Margin="18" RenderTransformOrigin="0.5,0.25">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ChromeScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- ======================= Classic frame ======================= -->
        <Border x:Name="ClassicFrame"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource SurfaceBorder}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34" ShadowDepth="7" Opacity="0.55" Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- ========================= HUD frame ========================= -->
        <!-- Cut-corner outline. Its geometry is built in code on every resize, so the
             corners keep a fixed 45-degree cut instead of stretching with the window.
             It lives in a Canvas because a Canvas reports no size of its own: a bare Path
             would ask for its geometry's size, the window would size itself to that, and
             the outline - built from the window's size - could then never shrink. -->
        <Canvas IsHitTestVisible="False">
            <Path x:Name="HudFrame"
                  Visibility="Collapsed"
                  Fill="{DynamicResource Surface}"
                  Stroke="{DynamicResource HudLine}"
                  StrokeThickness="1">
                <Path.Effect>
                    <DropShadowEffect x:Name="HudGlow" BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#35E6FF" />
                </Path.Effect>
            </Path>
            <!-- Second, inset outline: the double bevelled edge of a machined panel. -->
            <Path x:Name="HudFrameInner"
                  Visibility="Collapsed"
                  Stroke="{DynamicResource FrameInner}"
                  StrokeThickness="1" />
        </Canvas>

        <!-- Faint horizontal scanlines, clipped to the frame in code. -->
        <Rectangle x:Name="HudScanlines" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.55">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile"
                              Viewport="0,0,4,4" ViewportUnits="Absolute"
                              Viewbox="0,0,4,4" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="Transparent">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,4,4" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#1435E6FF">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,4,1" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Scan sweep: a band of light that runs down the panel as it powers up. -->
        <Rectangle x:Name="HudSweep"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"
                   Height="80"
                   VerticalAlignment="Top"
                   Opacity="0">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0035E6FF" Offset="0" />
                    <GradientStop Color="#1C35E6FF" Offset="0.82" />
                    <GradientStop Color="#9935E6FF" Offset="0.97" />
                    <GradientStop Color="#0035E6FF" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="HudSweepMove" Y="-80" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- Corner brackets, tracing the 16px cut of the frame. -->
        <Grid x:Name="HudCorners" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.9" Color="#35E6FF" />
            </Grid.Effect>
            <Path HorizontalAlignment="Left" VerticalAlignment="Top"
                  Data="M0.5,36 L0.5,16.5 L16.5,0.5 L36,0.5"
                  Stroke="{DynamicResource FrameBright}" StrokeThickness="2.2"
                  StrokeStartLineCap="Square" StrokeEndLineCap="Square" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Top"
                  Data="M0,0.5 L19.5,0.5 L35.5,16.5 L35.5,36"
                  Stroke="{DynamicResource FrameBright}" StrokeThickness="2.2" />
            <Path HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Data="M0.5,0 L0.5,19.5 L16.5,35.5 L36,35.5"
                  Stroke="{DynamicResource FrameBright}" StrokeThickness="2.2" />
            <Path HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Data="M35.5,0 L35.5,19.5 L19.5,35.5 L0,35.5"
                  Stroke="{DynamicResource FrameBright}" StrokeThickness="2.2" />

            <!-- Tick marks centred on the top edge. -->
            <Path HorizontalAlignment="Center" VerticalAlignment="Top"
                  Data="M0,0.5 L96,0.5 M0,0.5 L0,6 M16,0.5 L16,3.5 M32,0.5 L32,3.5 M48,0.5 L48,7 M64,0.5 L64,3.5 M80,0.5 L80,3.5 M96,0.5 L96,6"
                  Stroke="{DynamicResource FrameBright}" StrokeThickness="1.2" />
            <!-- And a short rule on the bottom edge. -->
            <Path HorizontalAlignment="Center" VerticalAlignment="Bottom"
                  Data="M0,0.5 L140,0.5"
                  Stroke="{DynamicResource HudDim}" StrokeThickness="1.2" />
        </Grid>

        <!-- ========================== content ========================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HUD header strip. -->
            <Grid x:Name="HudHeader" Grid.Row="0" Margin="26,11,26,0" Visibility="Collapsed">
                <TextBlock Text="BEACON  //  COMMAND INTERFACE"
                           FontFamily="{DynamicResource MonoFont}"
                           FontSize="9.5"
                           Foreground="{DynamicResource HudDim}"
                           HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="HudDot"
                             Width="6" Height="6"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource HudBright}" />
                    <TextBlock x:Name="HudState"
                               Text="SYSTEMS ONLINE"
                               FontFamily="{DynamicResource MonoFont}"
                               FontSize="9.5"
                               Foreground="{DynamicResource HudDim}" />
                </StackPanel>
            </Grid>

            <!-- Tactical header: emblem, title block, live readouts, date plate. -->
            <!-- Two separate angled tags floating over the desktop, not a panel: the
                 identity tag on the left, live readouts on the right. -->
            <Grid x:Name="TacHeader" Grid.Row="0" Margin="0,0,0,6" Visibility="Collapsed">
                <Grid HorizontalAlignment="Left">
                    <ui:ChamferPlate Fill="{DynamicResource PanelFill}"
                                     Stroke="{DynamicResource TileStroke}"
                                     CutTopLeft="12" CutBottomRight="12" />
                    <StackPanel Orientation="Horizontal" Margin="8,4,26,4">
                    <!-- Emblem: a machined disc, a turning segmented ring, and Beacon's mark. -->
                    <Viewbox Width="32" Height="32">
                    <Grid Width="52" Height="52">
                        <Ellipse StrokeThickness="1.5" Stroke="#FF6A6E74">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.35,0.3">
                                    <GradientStop Color="#FF45484D" Offset="0" />
                                    <GradientStop Color="#FF1B1C1F" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Margin="4"
                                 Stroke="{DynamicResource Accent}"
                                 StrokeThickness="2.5"
                                 StrokeDashArray="3 1.6"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="TacEmblemSpin" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Margin="10" Stroke="#FF55585E" StrokeThickness="1" />
                        <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M6,1.5 A8,8 0 0 0 6,16.5 M20,1.5 A8,8 0 0 1 20,16.5"
                              Stroke="{DynamicResource Accent}" StrokeThickness="2.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" />
                    </Grid>
                    </Viewbox>

                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BEACON OS"
                                   FontFamily="Agency FB"
                                   FontWeight="Bold"
                                   FontSize="17"
                                   Foreground="#FFE8E8E8" />
                        <TextBlock Margin="0,-2,0,0"
                                   FontFamily="Agency FB"
                                   FontSize="10.5"
                                   Foreground="#FF9A9DA2"><Run Text="VER 1.0  //  " /><Run Text="COMMAND MODULE" Foreground="{DynamicResource Accent}" /></TextBlock>
                    </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Live readouts and date. -->
                <Grid HorizontalAlignment="Right">
                    <ui:ChamferPlate Fill="{DynamicResource PanelFill}"
                                     Stroke="{DynamicResource TileStroke}"
                                     CutTopRight="12" CutBottomLeft="12" />
                    <StackPanel Orientation="Horizontal" Margin="24,4,12,4" VerticalAlignment="Center">
                        <!-- Greeting for the time of day, in the spot CPU/RAM used to hold. -->
                        <TextBlock x:Name="TacGreeting" Text="GOOD DAY" Margin="0,0,14,0" FontFamily="Agency FB" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TacTime" Text="00:00" Margin="0,0,12,0" FontFamily="Agency FB" FontWeight="Bold" FontSize="15" Foreground="#FFE0E0E0" VerticalAlignment="Center" />
                        <Rectangle Width="1" Margin="0,3,10,3" Fill="{DynamicResource HudDim}" />
                        <TextBlock x:Name="TacDay"
                                   Text="01"
                                   FontFamily="Agency FB"
                                   FontWeight="Bold"
                                   FontSize="26"
                                   Foreground="#FFEDEDED"
                                   VerticalAlignment="Center" />
                        <StackPanel Margin="5,0,0,0" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Accent}" Padding="5,0">
                                <TextBlock x:Name="TacMonth"
                                           Text="JAN"
                                           FontFamily="Agency FB"
                                           FontWeight="Bold"
                                           FontSize="10.5"
                                           Foreground="#FF17181A" />
                            </Border>
                            <TextBlock x:Name="TacWeekday"
                                       Text="MON"
                                       HorizontalAlignment="Right"
                                       FontFamily="Agency FB"
                                       FontSize="10.5"
                                       Foreground="#FFC6C8CC" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ========================= query row ========================= -->
            <Grid x:Name="QueryRow" Grid.Row="1" Height="62">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Tactical: the command bar is itself an angled key - a translucent body
                     over a lighter lip, with an amber edge on the bottom right. -->
                <Grid x:Name="QueryPlate"
                      Grid.ColumnSpan="5"
                      Visibility="Collapsed"
                      IsHitTestVisible="False">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.55" Color="#000000" />
                    </Grid.Effect>
                    <ui:ChamferPlate Height="5"
                                     Margin="80,0,0,0"
                                     VerticalAlignment="Bottom"
                                     Fill="{DynamicResource TileLip}"
                                     CutBottomLeft="5" />
                    <!-- Amber progress along the lip: the current Dotline focus session, or
                         how much of today has passed. TacProgressLabel says which. -->
                    <Rectangle x:Name="TacProgress"
                               Height="5"
                               Margin="80,0,0,0"
                               VerticalAlignment="Bottom"
                               Fill="{DynamicResource Accent}"
                               RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="TacProgressScale" ScaleX="0" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock x:Name="TacProgressLabel"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,18,-17"
                               FontFamily="Agency FB"
                               FontSize="11"
                               Foreground="{DynamicResource Accent}" />
                    <ui:ChamferPlate Margin="0,0,0,5"
                                     Fill="{DynamicResource QueryFill}"
                                     Stroke="{DynamicResource TileStroke}"
                                     CutTopLeft="14"
                                     CutTopRight="20"
                                     CutBottomLeft="4" />
                </Grid>

                <!-- Search glyph; in HUD it sits inside a spinning reactor ring. -->
                <Grid x:Name="Reactor"
                      Grid.Column="0"
                      Width="40" Height="40"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center">
                    <Ellipse x:Name="ReactorOuter"
                             Visibility="Collapsed"
                             Stroke="{DynamicResource HudBright}"
                             StrokeThickness="1.6"
                             StrokeDashArray="5 3"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="ReactorSpin" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="ReactorInner"
                             Visibility="Collapsed"
                             Margin="5"
                             Stroke="{DynamicResource HudLine}"
                             StrokeThickness="1"
                             StrokeDashArray="14 5"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="ReactorCounterSpin" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="ModeGlyph"
                               Text="&#xE721;"
                               FontFamily="{StaticResource GlyphFont}"
                               FontSize="16"
                               Foreground="{DynamicResource GlyphTint}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Search scope chip: "[logo] YouTube" at the start of the bar while
                     searching inside one site. Hidden outside scope mode. -->
                <Border x:Name="ScopeChip"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Margin="12,0,0,0"
                        Padding="9,5,11,5"
                        VerticalAlignment="Center"
                        CornerRadius="{DynamicResource RowCorner}"
                        Background="{DynamicResource ChipFill}"
                        BorderBrush="{DynamicResource ChipBorder}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <TextBlock x:Name="ScopeGlyph"
                                       FontFamily="{StaticResource GlyphFont}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <!-- Light tile for the same reason as result rows: dark logos
                                 disappear against the tinted chip. -->
                            <Border x:Name="ScopeIconPlate"
                                    Width="20" Height="20"
                                    CornerRadius="5"
                                    Background="#F2F4F4F6"
                                    Visibility="Collapsed">
                                <Image x:Name="ScopeIcon"
                                       Width="14" Height="14"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="ScopeName"
                                   Margin="8,0,0,0"
                                   FontFamily="{DynamicResource TitleFont}"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Inline completion. Sits *under* the TextBox with identical font metrics
                     and padding: the already-typed part is rendered transparent so only the
                     predicted remainder shows, and the two stay glyph-aligned because the
                     transparent run contains the user's own characters. -->
                <TextBlock x:Name="Ghost"
                           Grid.Column="2"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="{DynamicResource QuerySize}"
                           TextTrimming="None"
                           Visibility="Collapsed"><Run x:Name="GhostTyped" Foreground="Transparent" /><Run x:Name="GhostRest" Foreground="{DynamicResource TextTertiary}" /></TextBlock>

                <TextBox x:Name="QueryBox"
                         Grid.Column="2"
                         Margin="10,0,8,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource Accent}"
                         SelectionBrush="{DynamicResource Accent}"
                         FontFamily="{DynamicResource UiFont}"
                         FontSize="{DynamicResource QuerySize}"
                         MaxLength="400" />

                <!-- Sits behind the TextBox visually; hidden as soon as anything is typed. -->
                <TextBlock x:Name="Placeholder"
                           Grid.Column="2"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Text="Search apps, files and commands&#8212;or ? to ask Claude"
                           Foreground="{DynamicResource TextTertiary}"
                           FontFamily="{DynamicResource UiFont}"
                           FontSize="{DynamicResource QuerySize}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock x:Name="BusyGlyph"
                           Grid.Column="3"
                           Text="&#xE9F5;"
                           FontFamily="{StaticResource GlyphFont}"
                           FontSize="15"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Visibility="Collapsed"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform x:Name="BusyRotation" />
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- Microphone. A Border rather than a Button so it can never take keyboard
                     focus away from the query box - clicking it must not change where
                     typing goes. -->
                <Border x:Name="MicButton"
                        Grid.Column="4"
                        Width="38" Height="38"
                        Margin="0,0,14,0"
                        CornerRadius="19"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Speak your search  (Ctrl+M)">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverFill}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <!-- Pulses with input level while listening. -->
                        <Ellipse x:Name="MicLevel"
                                 Fill="{DynamicResource ListenFill}"
                                 Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="MicLevelScale" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock x:Name="MicGlyph"
                                   Text="&#xE720;"
                                   FontFamily="{StaticResource GlyphFont}"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================= results ========================= -->
            <Border Grid.Row="2"
                    x:Name="ResultsPanel"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <ListBox x:Name="ResultsList"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="392"
                         Padding="4,6"
                         Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ResultItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="{StaticResource GlyphFont}"
                                               FontSize="17"
                                               Foreground="{Binding AccentBrush}"
                                               Visibility="{Binding GlyphVisibility}" />
                                    <!-- App and file icons: drawn as-is. -->
                                    <Image Source="{Binding Icon}"
                                           Width="24" Height="24"
                                           HorizontalAlignment="Left"
                                           Visibility="{Binding IconVisibility}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <!-- Site icons sit on a light tile. Many favicons are black
                                         marks on transparency (GitHub, X, Notion) and vanish
                                         against the dark bar without one. -->
                                    <Border Width="26" Height="26"
                                            HorizontalAlignment="Left"
                                            CornerRadius="7"
                                            Background="#F2F4F4F6"
                                            Visibility="{Binding FaviconVisibility}">
                                        <Image Source="{Binding Icon}"
                                               Width="17" Height="17"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{DynamicResource TitleFont}"
                                               FontSize="{DynamicResource RowTitleSize}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               FontFamily="{DynamicResource UiFont}"
                                               FontSize="{DynamicResource RowSubSize}"
                                               Margin="0,1,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding SubtitleVisibility}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding SourceTag}"
                                           Foreground="{DynamicResource TextTertiary}"
                                           FontFamily="{DynamicResource TagFont}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ==================== confirmation / AI panel ==================== -->
            <Border Grid.Row="3"
                    x:Name="NoticePanel"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14"
                    Visibility="Collapsed">
                <Grid>
                <!-- Backing plate for the floating Tactical look; transparent otherwise. -->
                <ui:ChamferPlate Margin="-16,-10,-16,-10"
                                 Fill="{DynamicResource PanelFill}"
                                 Stroke="{DynamicResource TileStroke}"
                                 CutTopLeft="10" CutBottomRight="10" />
                <StackPanel>
                    <TextBlock x:Name="NoticeTitle"
                               Foreground="{DynamicResource TextPrimary}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="14"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="NoticeBody"
                               Foreground="{DynamicResource TextSecondary}"
                               FontFamily="{DynamicResource UiFont}"
                               FontSize="12"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                </Grid>
            </Border>

            <!-- ========================= status bar ========================= -->
            <Border Grid.Row="4"
                    x:Name="StatusBar"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,1,0,0"
                    Padding="20,8,20,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:ChamferPlate x:Name="StatusPlate"
                                     Grid.ColumnSpan="2"
                                     Margin="-14,-5,-14,-5"
                                     Fill="{DynamicResource PanelFill}"
                                     Stroke="{DynamicResource TileStroke}"
                                     CutTopRight="9" CutBottomLeft="9" />
                    <TextBlock x:Name="StatusLeft"
                               Grid.Column="0"
                               Foreground="{DynamicResource TextTertiary}"
                               FontFamily="{DynamicResource TagFont}"
                               FontSize="11"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock x:Name="StatusRight"
                                   MaxWidth="280"
                                   Foreground="{DynamicResource TextTertiary}"
                                   FontFamily="{DynamicResource TagFont}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HudClock"
                                   Visibility="Collapsed"
                                   Margin="14,0,0,0"
                                   FontFamily="{DynamicResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource HudBright}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
