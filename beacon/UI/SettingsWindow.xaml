                    </Border>
                </StackPanel>

                <!-- ======================== Local AI ========================= -->
                <StackPanel x:Name="PageLocalAi" Visibility="Collapsed">
                    <TextBlock Text="Prompt Ring" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Dictate what you want, select it, press Ctrl+Alt+P, and pick what it's for. A free AI model on this PC rewrites it into a well-structured prompt, right where it was. No account, no key, nothing uploaded." />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="How it works" Style="{StaticResource GroupHeader}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="12.5" LineHeight="19">
                                1. Select the text in any app: a chat box, a document, an email.<LineBreak />
                                2. Press <Run FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Text="Ctrl+Alt+P" /> (change it on the Shortcuts page: “Shape Prompt”).<LineBreak />
                                3. Pick a slice, or press its number: Build, Fix, Workflow, Research, Write, Explain, Plan, or Clean up.<LineBreak />
