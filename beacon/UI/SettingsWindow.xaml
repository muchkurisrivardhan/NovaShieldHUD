                                       Text="Gmail: turn on 2-Step Verification, then create an app password at myaccount.google.com/apppasswords and paste it here. Yahoo and iCloud have app passwords too. Outlook and Hotmail no longer allow app passwords, so they can't be added yet." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Opacity="0.55">
                        <DockPanel>
                            <TextBlock Text="COMING SOON" DockPanel.Dock="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="Calendar" Style="{StaticResource GroupHeader}" />
                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Text="“What's on tomorrow?” Your events, read-only." />
