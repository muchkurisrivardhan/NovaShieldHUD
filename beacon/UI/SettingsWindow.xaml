                                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Text="“Add milk to my list.” Your notes and to-dos." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Opacity="0.55">
                        <DockPanel>
                            <TextBlock Text="COMING SOON" DockPanel.Dock="Right" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="More add-ons" Style="{StaticResource GroupHeader}" />
