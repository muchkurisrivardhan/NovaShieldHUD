<Project Sdk="Microsoft.NET.Sdk">

  <!-- The lock screen HUD: renders the background PNG (WPF drawing, no packages).
       Applying it, widgets and scheduling come in later milestones. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Lockscreen</AssemblyName>
    <RootNamespace>Vantage.Lockscreen</RootNamespace>
  </PropertyGroup>

</Project>
